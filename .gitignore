# 密钥与本地环境
.env
.env.*
!.env.example

# 有效只读输入：视频数据（约 283MB，含 cookies/原始媒体）。全量本地只读，不入库。
data/

# 有效只读输入：第三方 skills 参考（约 73MB，许可证各异）。全量本地只读，不入库。
参考素材/

# 用户生成的原始写作模板：仅作规划输入；归一后的 runtime 模板放 skills/templates/
写作模板/

# 运行产物：可重建，按 run 落盘；不进入版本库
runs/
*.log

# IDE 本地历史
.history/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# 虚拟环境（本项目使用 conda 环境 myagent，不在仓库内）
.venv/
venv/

# 编辑器 / 系统
.vscode/
.idea/
.DS_Store
Thumbs.db

# Claude Code 本地状态
.claude/

# 历史归档：仅用于人工追溯，新 session 不读
_archive/

# v2 / 冻结 / 领域参考：只留磁盘作为素材，不进入 v3 分支
docs/_frozen/
video-writing-product-architecture/
