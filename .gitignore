# 密钥与本地环境
.env
.env.*
!.env.example

# 参考数据：体积大且包含 cookies / 原始媒体，只读使用，不进入版本库
data/

# 用户提供的第三方 skills 参考：体积大、许可证各异，默认不入库
# 许可见 video-writing-product-architecture/14_... §9
参考素材/

# 用户生成的原始写作模板：仅作规划输入；归一后的 runtime 模板放 skills/templates/
写作模板/

# 运行产物：可重建，按 run 落盘；不进入版本库
runs/
*.log

# IDE 本地历史
.history/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# 虚拟环境（本项目使用 conda 环境 myagent，不在仓库内）
.venv/
venv/

# 编辑器 / 系统
.vscode/
.idea/
.DS_Store
Thumbs.db

# 历史归档：仅用于人工追溯，新 session 不读
_archive/

# v2 / 冻结 / 领域参考：只留磁盘作为素材，不进入 v3 分支
docs/_frozen/
video-writing-product-architecture/
src/lunograph/writing_v2/
src/lunograph/prompts_v2/
src/lunograph/prompts/
skills/methods/
tests/writing_v2/
AB/
portfolio/
