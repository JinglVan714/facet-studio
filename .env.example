# Facet Studio environment template.
# Copy to .env and fill the values you need.  Never commit the real .env.

# --- LLM provider (writing engine / planner) ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# --- Evidence layer (ASR / VLM, DashScope) ---
DASHSCOPE_API_KEY=
# ASR default: qwen-audio-3.1-asr-flash-streaming; VLM default: qwen3.8-27b.

# --- Optional Langfuse tracing for the evidence layer ---
# Leave empty to keep tracing disabled.  Local JSONL remains the source of truth.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
LMIND_TRACE_CONTENT=

# --- Paths (all optional; defaults are under the project root) ---
# FACET_STUDIO_PROJECT_ROOT=
# FACET_STUDIO_DATA_ROOT=
# FACET_STUDIO_RUNS_ROOT=
# FACET_STUDIO_SKILLS_ROOT=
# FACET_STUDIO_SETTINGS_ROOT=

# --- External binaries (optional; otherwise resolved from PATH) ---
# FACET_STUDIO_PANDOC=
# FACET_STUDIO_TECTONIC=
# FACET_STUDIO_NODE=
# FACET_STUDIO_PLAYWRIGHT=

# --- Preview server base URL used in MCP responses ---
FACET_STUDIO_PREVIEW_BASE=http://127.0.0.1:8765/runs

# --- Optional cost estimate (USD per 1M tokens) ---
FACET_STUDIO_INPUT_COST_PER_MTOK=
FACET_STUDIO_OUTPUT_COST_PER_MTOK=

# --- Bilibili login cookies (optional) ---
# The evidence layer uses <data>/cookies/bilibili.txt when it exists.
# Do not commit cookies or read them into logs/artifacts.
