diff --git a/client/src/utils/facet.ts b/client/src/utils/facet.ts
new file mode 100644
index 0000000..b3a67dc
--- /dev/null
+++ b/client/src/utils/facet.ts
@@ -0,0 +1,170 @@
+/** Facet Studio chat helpers: parse MCP tool parts without showing raw JSON. */
+
+export const FACET_TOOLS = new Set([
+  'ingest_source',
+  'list_sources',
+  'resolve_source',
+  'compile_content',
+  'plan_article',
+  'write_form',
+  'typeset_article',
+  'get_run',
+  'review_artifact',
+  'start_workflow',
+  'wait_workflow',
+  'resume_workflow',
+  'get_workflow',
+]);
+
+export function isFacetToolName(name: string | null | undefined): boolean {
+  if (!name) {
+    return false;
+  }
+  if (name.includes('_mcp_facet_studio')) {
+    return true;
+  }
+  return FACET_TOOLS.has(name);
+}
+
+/** A tool payload truncated by LibreChat can end inside the run id. That
+ *  fragment must not become a second card; every run id this product creates
+ *  is `timestamp_video_form`. */
+export function isFacetRunId(value: unknown): value is string {
+  const text = typeof value === 'string' ? value : '';
+  return /^\d{8}T\d{6}Z_.+_(long_article|wechat_article|xiaohongshu_note)$/.test(text);
+}
+
+export function isFacetPart(part: any): boolean {
+  if (!part || part.type !== 'tool_call') {
+    return false;
+  }
+  const tc = part.tool_call || part;
+  return isFacetToolName(tc?.name);
+}
+
+export function safeParse(text: string): unknown {
+  try {
+    return JSON.parse(text);
+  } catch {
+    // Tool output can be wrapped in prose or stringified content parts.
+  }
+  const start = text.indexOf('{');
+  const end = text.lastIndexOf('}');
+  if (start >= 0 && end > start) {
+    try {
+      return JSON.parse(text.slice(start, end + 1));
+    } catch {
+      // fall through
+    }
+  }
+  return null;
+}
+
+export function findFacetObject(value: unknown, depth = 0): Record<string, any> | null {
+  if (!value || depth > 5) {
+    return null;
+  }
+  if (typeof value === 'string') {
+    return findFacetObject(safeParse(value), depth + 1);
+  }
+  if (typeof value !== 'object') {
+    return null;
+  }
+  if (Array.isArray(value)) {
+    for (const item of value) {
+      const found = findFacetObject(item, depth + 1);
+      if (found) {
+        return found;
+      }
+    }
+    return null;
+  }
+  const obj = value as Record<string, any>;
+  if (obj.run_id || obj.preview_url || obj.trace_url || obj.interrupt) {
+    return obj;
+  }
+  for (const key of ['output', 'result', 'content', 'data', 'tool_call']) {
+    const found = findFacetObject(obj[key], depth + 1);
+    if (found) {
+      return found;
+    }
+  }
+  return null;
+}
+
+function stringField(text: string, key: string): string {
+  const at = text.indexOf(`"${key}"`);
+  if (at < 0) {
+    return '';
+  }
+  const tail = text.slice(at, at + 600);
+  const match = tail.match(/:\s*"([^"]*)"/);
+  return match?.[1] || '';
+}
+
+/** LibreChat may truncate a large MCP payload before it reaches the client.
+ *  run_id/form/status/trace_url are near the top, so recover them without
+ *  pretending the truncated JSON parsed. Full details come from /api/card. */
+function truncatedFacetPayload(text: string): Record<string, any> | null {
+  const runId = stringField(text, 'run_id');
+  if (!runId) {
+    return null;
+  }
+  return {
+    run_id: runId,
+    form: stringField(text, 'form'),
+    form_label: stringField(text, 'form_label'),
+    status: stringField(text, 'status'),
+    trace_url: stringField(text, 'trace_url'),
+    video_id: stringField(text, 'video_id'),
+  };
+}
+
+export type FacetRun = {
+  runId: string;
+  payload: Record<string, any>;
+};
+
+/** Scan a message's content parts and merge every Facet payload by run_id. */
+export function collectFacetRuns(content: Array<any> | null | undefined): FacetRun[] {
+  const runs = new Map<string, Record<string, any>>();
+  for (const part of content || []) {
+    if (!part || part.type !== 'tool_call') {
+      continue;
+    }
+    const tc = part.tool_call || part;
+    if (!isFacetToolName(tc?.name) || !tc?.output) {
+      continue;
+    }
+    const payload =
+      findFacetObject(safeParse(tc.output)) || truncatedFacetPayload(tc.output);
+    if (!payload?.run_id || !isFacetRunId(payload.run_id)) {
+      continue;
+    }
+    const runId = String(payload.run_id);
+    const previous = runs.get(runId) || {};
+    runs.set(runId, {
+      ...previous,
+      ...payload,
+      plan: payload.plan || previous.plan,
+      write: payload.write || previous.write,
+      typeset: payload.typeset || previous.typeset,
+      interrupt: payload.interrupt || previous.interrupt,
+      review: payload.review || previous.review,
+    });
+  }
+  return Array.from(runs.entries()).map(([runId, payload]) => ({ runId, payload }));
+}
+
+export function facetArtifactUrl(
+  value: string | null | undefined,
+  base: string,
+): string {
+  if (!value) {
+    return '';
+  }
+  if (/^https?:\/\//.test(value)) {
+    return value;
+  }
+  return `${base.replace(/\/+$/, '')}/${value.replace(/^\/+/, '')}`;
+}
