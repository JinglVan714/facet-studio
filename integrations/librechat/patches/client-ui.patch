@@ -0,0 +1,474 @@
+import { useEffect, useMemo, useState } from 'react';
+import { ChevronDown } from 'lucide-react';
+import { facetArtifactUrl, type FacetRun } from '~/utils/facet';
+import FacetPreviewPanel, { type FacetPreviewItem } from './FacetPreviewPanel';
+
+const FORM_LABEL: Record<string, string> = {
+  long_article: '深度总结',
+  wechat_article: '公众号',
+  xiaohongshu_note: '小红书',
+};
+
+const STATUS_LABEL: Record<string, string> = {
+  starting: '正在启动',
+  running: '正在进行',
+  intake: '读取内容',
+  plan: '规划中',
+  planned: '规划完成',
+  written: '初稿完成',
+  typeset: '等待验收',
+  partial: '部分完成',
+  awaiting_plan_approval: '等待计划确认',
+  awaiting_review: '等待验收',
+  approved: '已验收',
+  changes_requested: '要修改',
+  rejected: '已拒绝',
+  failed: '失败',
+  cancelled: '已取消',
+};
+
+const STAGE_LABEL: Record<string, string> = {
+  intake: '读取内容',
+  plan: '规划',
+  approval: '确认计划',
+  write: '写作',
+  typeset: '排版',
+  review: '验收',
+};
+
+const STOP_STATUSES = new Set([
+  'awaiting_plan_approval',
+  'awaiting_review',
+  'typeset',
+  'partial',
+  'approved',
+  'changes_requested',
+  'rejected',
+  'failed',
+  'cancelled',
+]);
+
+const DONE_STAGE = new Set([
+  'succeeded',
+  'typeset',
+  'approved',
+  'auto_approved',
+  'auto_accepted',
+  'completed',
+]);
+
+function seconds(value: number) {
+  const total = Math.max(0, Math.round(value / 1000));
+  if (total < 60) {
+    return `${total} 秒`;
+  }
+  const minutes = Math.floor(total / 60);
+  const rest = total % 60;
+  return rest ? `${minutes} 分 ${rest} 秒` : `${minutes} 分`;
+}
+
+function toneFor(status: string) {
+  if (status === 'approved') {
+    return 'border-green-200 bg-green-50 text-green-700';
+  }
+  if (status === 'failed' || status === 'rejected') {
+    return 'border-red-200 bg-red-50 text-red-700';
+  }
+  if (
+    status === 'awaiting_plan_approval' ||
+    status === 'awaiting_review' ||
+    status === 'typeset' ||
+    status === 'partial'
+  ) {
+    return 'border-amber-200 bg-amber-50 text-amber-700';
+  }
+  return 'border-border-light bg-surface-primary text-text-secondary';
+}
+
+export default function FacetRunCard({ run }: { run: FacetRun }) {
+  const { runId, payload } = run;
+  const [trace, setTrace] = useState<Record<string, any> | null>(null);
+  const [error, setError] = useState('');
+  const [expanded, setExpanded] = useState(true);
+  const [previewOpen, setPreviewOpen] = useState(false);
+
+  const base =
+    trace?.trace_url ||
+    payload.trace_url ||
+    `http://127.0.0.1:8765/runs/${encodeURIComponent(runId)}`;
+
+  useEffect(() => {
+    let timer: ReturnType<typeof setTimeout> | null = null;
+    let cancelled = false;
+
+    const load = async () => {
+      try {
+        const response = await fetch(`${base}/api/card`, { cache: 'no-store' });
+        if (!response.ok) {
+          throw new Error(`HTTP ${response.status}`);
+        }
+        const data = (await response.json()) as Record<string, any>;
+        if (cancelled) {
+          return;
+        }
+        setTrace(data);
+        setError('');
+        const status = String(data.workflow_status || data.status || '');
+        if (!STOP_STATUSES.has(status)) {
+          timer = setTimeout(load, 1500);
+        }
+      } catch {
+        if (!cancelled) {
+          setError('运行服务未连接，稍后重试');
+          timer = setTimeout(load, 2500);
+        }
+      }
+    };
+
+    load();
+    return () => {
+      cancelled = true;
+      if (timer) {
+        clearTimeout(timer);
+      }
+    };
+  }, [base]);
+
+  const rawStatus = String(
+    trace?.workflow_status || trace?.status || payload.status || 'starting',
+  );
+  const status = rawStatus === 'unknown' ? 'starting' : rawStatus;
+  const phase =
+    status === 'failed' || status === 'cancelled'
+      ? 'failed'
+      : status === 'approved' || status === 'rejected' || status === 'changes_requested'
+        ? 'done'
+        : status === 'awaiting_plan_approval'
+          ? 'waiting_plan'
+          : status === 'awaiting_review' || status === 'typeset' || status === 'partial'
+            ? 'waiting_review'
+            : status === 'starting'
+              ? 'starting'
+              : 'running';
+
+  const form = String(trace?.form || payload.form || '');
+  const formLabel = String(trace?.form_label || payload.form_label || FORM_LABEL[form] || '文章');
+  const context = trace?.context || {};
+  const title = String(
+    context.central_idea || payload.plan?.central_idea || payload.request || '本次写作',
+  );
+  const stages: Array<Record<string, any>> = trace?.stages || [];
+  const stageMap = useMemo(() => new Map(stages.map((item) => [item.name, item])), [stages]);
+  const story: Array<Record<string, any>> = trace?.story || [];
+  const activeStage = stages.find((item) => !DONE_STAGE.has(String(item.status || '')));
+  const currentLabel =
+    STAGE_LABEL[String(activeStage?.name || '')] ||
+    (Number(context.visual_audit?.candidate_count || 0) > 0 ? '检查候选图' : '读取内容');
+  const usage = trace?.usage || {};
+  const tokens = Number(usage.total_tokens || payload.usage?.total_tokens || 0);
+  const latency = Number(trace?.latency_ms || payload.latency_ms || 0);
+  const outputChars = Number(context.output_chars || payload.write?.output_chars || 0);
+  const payloadRefs = payload.write?.figures_referenced;
+  const payloadKeyframes = Array.isArray(payloadRefs)
+    ? payloadRefs.filter((item: string) => !String(item).toLowerCase().endsWith('.svg')).length
+    : Number(payloadRefs || 0);
+  const figures = Number(context.keyframes_referenced ?? payloadKeyframes ?? 0);
+  const svgCount = Number(
+    context.svg_count ??
+      (Array.isArray(payload.write?.svg_assets) ? payload.write.svg_assets.length : 0),
+  );
+  const cardCount = Number(context.card_count || 0);
+  const visualAudit = context.visual_audit || payload.visual_audit || {};
+  const auditCandidates = Number(visualAudit.candidate_count || 0);
+  const auditApproved = Number(visualAudit.approved_count || 0);
+  const auditReasons = Object.keys(visualAudit.reasons || {});
+  const auditLine =
+    auditApproved > 0
+      ? `视觉审计：${auditCandidates} 张候选，${auditApproved} 张采用`
+      : auditCandidates > 0
+        ? `视觉审计：${auditCandidates} 张候选都没通过（${auditReasons[0] || '画面不合适'}${
+            auditReasons.length > 1 ? '等' : ''
+          }），这次不用视频截图`
+        : '';
+  const planAngle = String(context.plan_angle || payload.plan?.angle || payload.angle || '');
+  const planReader = String(
+    context.plan_reader || payload.plan?.reader_goal || payload.reader_goal || '',
+  );
+  const request = String(context.request || payload.request || '');
+  const artifacts = trace?.artifacts || payload.artifacts || {};
+  const previewItems: FacetPreviewItem[] = [];
+  const addPreview = (label: string, value: unknown) => {
+    const href = facetArtifactUrl(typeof value === 'string' ? value : '', base);
+    if (href && !previewItems.some((item) => item.url === href)) {
+      previewItems.push({ label, url: href });
+    }
+  };
+  addPreview('阅读页', artifacts.preview_url || artifacts.reader_html);
+  addPreview('公众号', artifacts.wechat_url || artifacts.wechat_html);
+  addPreview('PDF', artifacts.pdf_url);
+  const canPreview = phase === 'waiting_review' || phase === 'done';
+  const reviewDecision = String(trace?.review?.decision || payload.review_status || '');
+  const statusLabel = STATUS_LABEL[status] || status;
+
+  useEffect(() => {
+    if (phase === 'done' || phase === 'failed') {
+      setExpanded(false);
+    } else if (phase === 'waiting_review' || phase === 'waiting_plan' || phase === 'running') {
+      setExpanded(true);
+    }
+  }, [phase]);
+
+  const steps = [
+    { name: 'intake', label: '读取' },
+    { name: 'plan', label: '规划' },
+    { name: 'write', label: '写作' },
+    { name: 'typeset', label: '排版' },
+  ];
+  const stepState = (name: string) => {
+    const stage = stageMap.get(name);
+    if (stage) {
+      return DONE_STAGE.has(String(stage.status || '')) ? 'done' : 'current';
+    }
+    if (phase === 'waiting_review' || phase === 'done') {
+      return 'done';
+    }
+    if (phase === 'waiting_plan' && name === 'plan') {
+      return 'done';
+    }
+    return 'todo';
+  };
+  const currentLine =
+    phase === 'waiting_plan'
+      ? '计划已生成，等你确认'
+      : phase === 'waiting_review'
+        ? `草稿 · 等你验收${outputChars ? ` · ${outputChars.toLocaleString()} 字` : ''}`
+        : phase === 'done'
+          ? `${reviewDecision === 'approved' ? '已验收' : statusLabel}${
+              outputChars ? ` · ${outputChars.toLocaleString()} 字` : ''
+            }`
+          : phase === 'failed'
+            ? error || '运行失败'
+            : phase === 'starting'
+              ? '正在读取内容和准备计划'
+              : `正在${currentLabel}${latency ? ` · 已用 ${seconds(latency)}` : ''}`;
+
+  return (
+    <section
+      className="border-border-light bg-surface-secondary mt-2 overflow-hidden rounded-xl border"
+      data-testid="facet-run-card"
+      data-run-id={runId}
+    >
+      <button
+        type="button"
+        className="hover:bg-surface-tertiary flex w-full items-start justify-between gap-3 px-3.5 py-3 text-left transition-colors"
+        onClick={() => setExpanded((value) => !value)}
+      >
+        <div className="min-w-0">
+          <div className="flex flex-wrap items-center gap-2 text-[11px]">
+            <span className="text-text-secondary font-semibold tracking-wide">FACET STUDIO</span>
+            <span className="border-border-light bg-surface-primary text-text-secondary rounded-full border px-2 py-0.5">
+              {formLabel}
+            </span>
+            <span className={`rounded-full border px-2 py-0.5 ${toneFor(status)}`}>{statusLabel}</span>
+          </div>
+          <div className="text-text-primary mt-1.5 line-clamp-2 text-sm font-semibold leading-relaxed">
+            {title}
+          </div>
+          <div className="text-text-secondary mt-1 text-xs">{currentLine}</div>
+        </div>
+        <ChevronDown
+          className={`text-text-secondary mt-0.5 size-4 shrink-0 transition-transform ${
+            expanded ? 'rotate-180' : ''
+          }`}
+        />
+      </button>
+
+      {expanded && (
+        <div className="border-border-light border-t px-3.5 py-3">
+          <div className="flex items-center gap-1.5">
+            {steps.map((step, index) => {
+              const state = stepState(step.name);
+              return (
+                <div key={step.name} className="flex min-w-0 flex-1 items-center gap-1.5">
+                  <div
+                    className={`flex min-w-0 flex-1 items-center gap-1.5 rounded-lg px-2 py-1 text-[11px] ${
+                      state === 'done'
+                        ? 'bg-green-50 text-green-700'
+                        : state === 'current'
+                          ? 'bg-amber-50 text-amber-700'
+                          : 'bg-surface-primary text-text-secondary'
+                    }`}
+                  >
+                    <span
+                      className={`inline-block size-1.5 shrink-0 rounded-full ${
+                        state === 'done'
+                          ? 'bg-green-500'
+                          : state === 'current'
+                            ? 'bg-amber-500'
+                            : 'bg-gray-300'
+                      }`}
+                    />
+                    <span className="truncate">{step.label}</span>
+                  </div>
+                  {index < steps.length - 1 && (
+                    <span className="text-gray-400 shrink-0 text-[10px]">→</span>
+                  )}
+                </div>
+              );
+            })}
+          </div>
+
+          {story.length > 0 && phase === 'running' && (
+            <div className="mt-3 space-y-1.5">
+              {story.map((item, index) => (
+                <div key={`${item.step}-${index}`} className="text-text-secondary flex gap-2 text-xs">
+                  <span className="text-text-tertiary w-3 shrink-0">{index + 1}.</span>
+                  <span className="min-w-0">
+                    <span className="text-text-primary font-medium">{item.step}</span>
+                    {item.detail ? ` · ${item.detail}` : ''}
+                  </span>
+                </div>
+              ))}
+            </div>
+          )}
+
+          {(planAngle || planReader || request) && (
+            <details className="mt-3" open={phase === 'waiting_plan'}>
+              <summary className="text-text-secondary cursor-pointer text-xs">本次计划</summary>
+              <div className="text-text-secondary mt-2 space-y-1 text-xs leading-relaxed">
+                {planAngle && (
+                  <div>
+                    <span className="text-text-primary font-medium">角度：</span>
+                    {planAngle}
+                  </div>
+                )}
+                {planReader && (
+                  <div>
+                    <span className="text-text-primary font-medium">读者收获：</span>
+                    {planReader}
+                  </div>
+                )}
+                {request && (
+                  <div>
+                    <span className="text-text-primary font-medium">你的要求：</span>
+                    {request}
+                  </div>
+                )}
+              </div>
+            </details>
+          )}
+
+          {auditLine && (
+            <div className="text-text-secondary bg-surface-primary mt-2 rounded-lg px-2.5 py-2 text-xs">
+              {auditLine}
+            </div>
+          )}
+
+          {phase === 'waiting_plan' && (
+            <div className="mt-3 rounded-lg bg-amber-50 px-3 py-2 text-xs text-amber-800">
+              回复「确认，开始写」继续；要调整就直接说「改：……」。
+            </div>
+          )}
+
+          {phase === 'waiting_review' && canPreview && previewItems.length > 0 && (
+            <div className="mt-3 flex flex-wrap items-center justify-between gap-2">
+              <div className="text-text-secondary text-xs">
+                {outputChars > 0 ? `${outputChars.toLocaleString()} 字` : '正文已生成'}
+                {form === 'xiaohongshu_note'
+                  ? ` · ${cardCount} 张卡片 · ${figures} 张关键帧`
+                  : ` · ${figures} 图`}
+                {svgCount > 0 ? ` · ${svgCount} 个图表` : ''}
+                <span className="ml-2">{' '}· 草稿，未验收</span>
+              </div>
+              <div className="flex items-center gap-2">
+                <button
+                  type="button"
+                  className="bg-text-primary text-surface-primary inline-flex items-center rounded-full px-3 py-1.5 text-xs font-medium"
+                  onClick={() => setPreviewOpen(true)}
+                >
+                  打开成品
+                </button>
+                <a
+                  href={base}
+                  target="_blank"
+                  rel="noopener noreferrer"
+                  className="text-text-secondary hover:text-text-primary text-xs underline-offset-2 hover:underline"
+                >
+                  运行详情
+                </a>
+              </div>
+            </div>
+          )}
+
+          {phase === 'waiting_review' && (
+            <div className="mt-2 rounded-lg bg-amber-50 px-3 py-2 text-xs text-amber-800">
+              回复「通过」验收；要改就说「改：……」；不要了就回「不要了」。
+            </div>
+          )}
+
+          {phase === 'done' && canPreview && previewItems.length > 0 && (
+            <div className="mt-3 flex flex-wrap items-center justify-between gap-2">
+              <div className="text-xs text-green-700">
+                {reviewDecision === 'approved' ? '你已验收' : statusLabel}
+                {outputChars > 0 ? ` · ${outputChars.toLocaleString()} 字` : ''}
+              </div>
+              <div className="flex items-center gap-2">
+                <button
+                  type="button"
+                  className="bg-text-primary text-surface-primary inline-flex items-center rounded-full px-3 py-1.5 text-xs font-medium"
+                  onClick={() => setPreviewOpen(true)}
+                >
+                  打开成品
+                </button>
+                <a
+                  href={base}
+                  target="_blank"
+                  rel="noopener noreferrer"
+                  className="text-text-secondary hover:text-text-primary text-xs underline-offset-2 hover:underline"
+                >
+                  运行详情
+                </a>
+              </div>
+            </div>
+          )}
+
+          {phase === 'failed' && (
+            <div className="mt-3 rounded-lg bg-red-50 px-3 py-2 text-xs text-red-700">
+              {error || trace?.errors?.[0] || '运行失败，请打开运行详情查看原因。'}
+            </div>
+          )}
+
+          <details className="text-text-secondary mt-3 text-[11px]">
+            <summary className="cursor-pointer">技术信息</summary>
+            <div className="mt-1.5 space-y-1 break-all">
+              <div>run：{runId}</div>
+              <div>
+                调用 {Number(trace?.calls_total || payload.calls_total || 0)} 次
+                {tokens > 0 ? ` · ${tokens.toLocaleString()} tokens` : ''}
+                {latency > 0 ? ` · ${seconds(latency)}` : ''}
+              </div>
+              {auditReasons.length > 0 && (
+                <div>
+                  审计明细：
+                  {Object.entries(visualAudit.reasons || {})
+                    .map(([key, value]) => `${key} ${value}`)
+                    .join(' · ')}
+                </div>
+              )}
+              <a href={base} target="_blank" rel="noopener noreferrer" className="underline">
+                打开运行详情
+              </a>
+            </div>
+          </details>
+        </div>
+      )}
+
+      <FacetPreviewPanel
+        open={previewOpen}
+        title={title}
+        items={previewItems}
+        onClose={() => setPreviewOpen(false)}
+      />
+    </section>
+  );
+}
