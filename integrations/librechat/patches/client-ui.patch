diff --git a/client/src/components/Facet/FacetActivity.tsx b/client/src/components/Facet/FacetActivity.tsx
new file mode 100644
index 0000000..922c66d
--- /dev/null
+++ b/client/src/components/Facet/FacetActivity.tsx
@@ -0,0 +1,29 @@
+import { useMemo } from 'react';
+import { useChatContext } from '~/Providers/ChatContext';
+import { collectFacetRuns } from '~/utils/facet';
+import FacetRunCard from './FacetRunCard';
+
+/** One product-level run card per assistant message, not one per tool call. */
+export default function FacetActivity({
+  content,
+  messageId,
+  isLatestMessage,
+}: {
+  content: Array<any> | null | undefined;
+  messageId?: string;
+  isLatestMessage: boolean;
+}) {
+  const { latestMessageId } = useChatContext();
+  const isLatest = latestMessageId && messageId ? messageId === latestMessageId : isLatestMessage;
+  const runs = useMemo(() => collectFacetRuns(content), [content]);
+  if (!isLatest || runs.length === 0) {
+    return null;
+  }
+  return (
+    <div className="mt-2 space-y-2" data-testid="facet-activity">
+      {runs.map((run) => (
+        <FacetRunCard key={run.runId} run={run} />
+      ))}
+    </div>
+  );
+}
diff --git a/client/src/components/Facet/FacetPreviewPanel.tsx b/client/src/components/Facet/FacetPreviewPanel.tsx
new file mode 100644
index 0000000..5b246c4
--- /dev/null
+++ b/client/src/components/Facet/FacetPreviewPanel.tsx
@@ -0,0 +1,100 @@
+import { useEffect, useState } from 'react';
+import { createPortal } from 'react-dom';
+import { ExternalLink, X } from 'lucide-react';
+
+export type FacetPreviewItem = { label: string; url: string };
+
+export default function FacetPreviewPanel({
+  open,
+  title,
+  items,
+  onClose,
+}: {
+  open: boolean;
+  title: string;
+  items: FacetPreviewItem[];
+  onClose: () => void;
+}) {
+  const [active, setActive] = useState(0);
+
+  useEffect(() => {
+    if (open) {
+      setActive(0);
+    }
+  }, [open]);
+
+  useEffect(() => {
+    if (!open) {
+      return;
+    }
+    const onKey = (event: KeyboardEvent) => {
+      if (event.key === 'Escape') {
+        onClose();
+      }
+    };
+    window.addEventListener('keydown', onKey);
+    return () => window.removeEventListener('keydown', onKey);
+  }, [open, onClose]);
+
+  if (!open || items.length === 0) {
+    return null;
+  }
+  const current = items[Math.min(active, items.length - 1)];
+
+  return createPortal(
+    <div className="fixed inset-0 z-[100] flex justify-end" data-testid="facet-preview-panel">
+      <div className="absolute inset-0 bg-black/30" onClick={onClose} aria-hidden="true" />
+      <section className="bg-surface-primary border-border-light relative flex h-full w-full max-w-[820px] flex-col border-l shadow-2xl">
+        <header className="border-border-light flex items-center justify-between gap-3 border-b px-4 py-3">
+          <div className="min-w-0">
+            <div className="text-text-primary truncate text-sm font-semibold">{title}</div>
+            <div className="text-text-secondary text-xs">Facet Studio · 成品预览</div>
+          </div>
+          <div className="flex items-center gap-1">
+            {items.map((item, index) => (
+              <button
+                key={item.label}
+                type="button"
+                onClick={() => setActive(index)}
+                className={`rounded-full px-2.5 py-1 text-xs ${
+                  index === Math.min(active, items.length - 1)
+                    ? 'bg-surface-tertiary text-text-primary font-medium'
+                    : 'text-text-secondary hover:text-text-primary'
+                }`}
+              >
+                {item.label}
+              </button>
+            ))}
+            <a
+              href={current.url}
+              target="_blank"
+              rel="noopener noreferrer"
+              className="text-text-secondary hover:text-text-primary ml-1 inline-flex h-8 w-8 items-center justify-center rounded-full"
+              title="在新标签打开"
+            >
+              <ExternalLink className="size-4" />
+            </a>
+            <button
+              type="button"
+              onClick={onClose}
+              className="text-text-secondary hover:text-text-primary inline-flex h-8 w-8 items-center justify-center rounded-full"
+              title="关闭"
+            >
+              <X className="size-4" />
+            </button>
+          </div>
+        </header>
+        <div className="min-h-0 flex-1 bg-white">
+          <iframe
+            key={current.url}
+            src={current.url}
+            title={current.label}
+            className="h-full w-full border-0"
+            allow="clipboard-read; clipboard-write"
+          />
+        </div>
+      </section>
+    </div>,
+    document.body,
+  );
+}
