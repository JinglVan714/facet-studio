# LibreChat local .env template (P1/P2)
# Copy to <LibreChat>/.env and fill secrets.
# Do NOT commit the real .env.

APP_TITLE=Facet Studio
HOST=localhost
PORT=3080
MONGO_URI=mongodb://127.0.0.1:27017/LibreChat
DOMAIN_CLIENT=http://localhost:3080
DOMAIN_SERVER=http://localhost:3080

# Generate:
#   python -c "import secrets; print(secrets.token_hex(32))"   # JWT_SECRET
#   python -c "import secrets; print(secrets.token_hex(32))"   # JWT_REFRESH_SECRET
#   python -c "import secrets; print(secrets.token_hex(32))"   # CREDS_KEY (32 bytes)
#   python -c "import secrets; print(secrets.token_hex(16))"   # CREDS_IV (16 bytes)
JWT_SECRET=
JWT_REFRESH_SECRET=
CREDS_KEY=
CREDS_IV=

ALLOW_EMAIL_LOGIN=true
ALLOW_REGISTRATION=true
ALLOW_SOCIAL_LOGIN=false
ALLOW_SOCIAL_REGISTRATION=false
ALLOW_UNVERIFIED_EMAIL_LOGIN=true
SEARCH=false
NODE_ENV=development
CONFIG_PATH=./librechat.yaml
CUSTOM_FOOTER="Facet Studio · 把一条视频变成可发布的文章"
# Optional single-process assertion for the scheduler warning:
# SCHEDULES_SINGLE_PROCESS=true

# DeepSeek (OpenAI-compatible)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL=deepseek-flash

# Optional P3 cost estimate (USD per 1M tokens); leave blank to report null.
FACET_STUDIO_INPUT_COST_PER_MTOK=
FACET_STUDIO_OUTPUT_COST_PER_MTOK=
